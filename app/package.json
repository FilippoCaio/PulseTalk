{
  "name": "pulse-talk",
  "version": "0.11.2",
  "description": "Voce, video e schermo senza i tetti di Discord, sul tuo NAS",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Pulse",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:android:web": "vite build --config vite.android.config.ts",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --win --dir",
    "dist:installer": "npm run build && npm run icon && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "livekit-client": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.3",
    "@capacitor/browser": "6.0.6",
    "@capacitor/core": "6.2.1",
    "@capacitor/preferences": "6.0.4",
    "electron-updater": "^6.8.9"
  }
}
