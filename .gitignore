node_modules/
dist/
out/
release/
*.tsbuildinfo

# I segreti: il tunnel, la chiave della SFU, il dominio.
deploy/.env
.env

# L'app web costruita: si rifa' con `npm run build:web`, e un bundle
# minimizzato dentro a git rende illeggibile ogni diff.
server/public/*
!server/public/.gitkeep

# La copia pronta da spingere sul NAS: e' server/ e deploy/ senza node_modules,
# messi insieme da una robocopy. Si rifa' in un secondo, e dentro c'e' il .env.
_nas/

# Il database e i dati di prova
*.db
*.db-wal
*.db-shm
# Ancorata alla radice, e non `dati/` come stava scritto prima.
#
# Senza la sbarra davanti la regola vale per QUALUNQUE cartella con quel nome a
# qualsiasi profondita', e ne esisteva una che di dati non ne contiene:
# `server/src/dati/`, che e' codice — i sei moduli che `db.mjs` importa per
# leggere e scrivere diretti, ruoli, media, inviti ed eventi. Restavano fuori
# dal repository in silenzio, e chi avesse ricostruito il server da git si
# sarebbe trovato con un `import` che non risolve.
/dati/
/server/dati/
/deploy/dati/

# L'icona: la rigenera `npm run icon`, e un binario che cambia a ogni build
# non ha niente da fare in un repository.
app/build/icon.ico
app/build/icona.png

# Indice locale usato per orientarsi nel progetto; si rigenera dal sorgente.
/graphify-out/

# L'indirizzo del proprio server, cotto dentro alle build fatte in casa.
# Fuori dal repo di proposito: la versione pubblica resta neutra.
app/server.local
# Dove caricare gli aggiornamenti: utente@host e cartella del proprio NAS.
# Sta fuori da git per la stessa ragione di server.local — e' la rete di casa
# di qualcuno, e non e' un valore predefinito per nessun altro.
app/nas.local
# Le copie del .env che installa.sh mette da parte prima di riscriverlo.
deploy/.env.prima-di-*
# Lo schema della Compose Specification, scaricato per far girare il controllo
# facoltativo di truenas/prova.py. E' di qualcun altro e non va vendorizzato.
truenas/compose-spec.json

# Gli archivi che `rilascio/assembla.ps1 -Zip` mette insieme per una release.
# Si rifanno in un secondo dai file che stanno gia' in `rilascio/server/`, e un
# .zip in git e' un binario che cambia per intero a ogni versione.
/rilascio/pacchetti/

# La cache dei moduli Python, lasciata da truenas/prova.py.
__pycache__/
